<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Кроссворд по фармакологии</title>
<style>
    body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin: 20px;
    }

    table {
        margin: 20px auto;
        border-collapse: collapse;
    }

    td {
        width: 35px;
        height: 35px;
        border: 1px solid #000;
        text-align: center;
        vertical-align: middle;
        font-size: 20px;
        font-weight: bold;
    }

    .empty {
        border: none;
    }

    .hidden-letter {
        color: transparent;
    }

    .show {
        color: black;
    }

    .number {
        position: relative;
    }

    .number::before {
        position: absolute;
        top: 1px;
        left: 2px;
        font-size: 10px;
        font-weight: normal;
    }

    .n1::before { content: "1"; }
    .n2::before { content: "2"; }
    .n3::before { content: "3"; }
    .n4::before { content: "4"; }
    .n5::before { content: "5"; }

    .clues {
        width: 700px;
        margin: auto;
        text-align: left;
    }

    button {
        padding: 10px 20px;
        font-size: 16px;
        cursor: pointer;
    }
</style>
</head>
